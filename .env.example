# ==============================================================================
# CloudPort Environment Configuration Example
# ==============================================================================
# NEVER commit sensitive service-account keys or API secrets to version control.
# In Google Cloud, authentication uses the attached Service Account via ADC.
# ==============================================================================

# Your Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Firestore Database Name ((default) for standard Native database)
FIRESTORE_DATABASE_ID=(default)

# Allowed CORS Origin for the Cloud Function
# Use '*' for local development, or set to your GCS website URL in production
ALLOWED_ORIGIN=*

# Local Development Port (functions-framework)
PORT=8080

# Cloud Function Entry Point
# Node.js: cloudportRegistration
# Python: cloudport_registration
FUNCTION_TARGET=cloudportRegistration

# Optional: Path to local service account key file FOR LOCAL OFFLINE TESTING ONLY
# DO NOT COMMIT THIS FILE OR KEY!
# GOOGLE_APPLICATION_CREDENTIALS=
